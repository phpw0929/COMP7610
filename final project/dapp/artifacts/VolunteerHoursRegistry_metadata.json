					"returns": {
						"serviceRecordIds": "Record IDs issued by the organization."
					}
				},
				"getOrganization(address)": {
					"params": {
						"wallet": "Registered organization wallet."
					},
					"returns": {
						"organization": "The public organization record."
					}
				},
				"getOrganizationActivityIds(address)": {
					"params": {
						"issuer": "Organization wallet whose activities should be returned."
					},
					"returns": {
						"activityIds": "Activity IDs, including open and closed activities."
					}
				},
				"getOrganizationById(uint256)": {
					"params": {
						"organizationId": "Organization identifier returned at registration."
					},
					"returns": {
						"organization": "The public organization record."
					}
				},
				"getServiceRecord(uint256)": {
					"params": {
						"recordId": "Record identifier to verify."
