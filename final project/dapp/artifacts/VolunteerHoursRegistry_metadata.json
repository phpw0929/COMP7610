		"devdoc": {
			"details": "Wallet addresses and all stored data are public. Do not submit personal details or secrets.      Metadata and reason hashes should be keccak256 hashes of the exact off-chain content;      a hash can check matching content but does not prove that the content is true.",
			"kind": "dev",
			"methods": {
				"approveClaim(uint256,uint32,bytes32)": {
					"details": "The organization may approve fewer or more minutes than claimed; both values remain recorded.",
					"params": {
						"approvedMinutes": "Approved duration in whole minutes (60 minutes = 1 hour).",
						"claimId": "Pending claim to approve.",
						"reviewNoteHash": "Optional hash of off-chain review notes."
					},
					"returns": {
						"recordId": "Newly issued service record identifier."
					}
				},
				"closeActivity(uint256)": {
					"details": "Pending claims remain reviewable by the active issuing organization.",
					"params": {
						"activityId": "Activity to close."
					}
				},
				"correctRecord(uint256,uint32,uint64,bytes32)": {
					"details": "The replacement keeps the same volunteer, issuer, activity, and claim; only the      approved minutes or service date may change. Use revokeRecord for other errors.",
					"params": {
						"correctedMinutes": "Corrected duration in whole minutes; must be positive.",
						"correctedServiceDate": "Corrected Unix timestamp in seconds, within the activity's date window.",
						"reasonHash": "Required keccak256 hash of the off-chain correction explanation.",
						"recordId": "Valid record to correct."
					},
					"returns": {
						"replacementRecordId": "New record ID linked to the corrected original."
					}
				},
				"createActivity(string,bytes32,string,uint64,uint64)": {
					"details": "The metadata URI and date window cannot be edited; close this activity and create      another one if its published details need to change.",
					"params": {
						"category": "Human-readable activity category.",
						"metadataHash": "keccak256 hash of the exact activity metadata bytes fetched from metadataURI.",
						"metadataURI": "Public off-chain activity details location.",
						"serviceEndDate": "Inclusive end of the service window, as a Unix timestamp in seconds.",
						"serviceStartDate": "Inclusive start of the service window, as a Unix timestamp in seconds."
					},
					"returns": {
						"activityId": "New activity identifier, starting at 1."
					}
				},
				"getActivity(uint256)": {
					"params": {
						"activityId": "Activity identifier."
					},
					"returns": {
						"activity": "The activity record."
